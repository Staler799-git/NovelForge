{
  "name": "novelforge",
  "private": true,
  "version": "1.0.0",
  "description": "NovelForge – Web Novel to EPUB Converter for iOS (React + TypeScript + Capacitor)",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "ios": "npx cap add ios && npx cap open ios",
    "ios:sync": "npx cap copy && npx cap sync ios",
    "ios:open": "npx cap open ios"
  },
  "dependencies": {
    "@capacitor-community/http": "^1.4.1",
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/app": "^6.0.0",
    "@capacitor/camera": "^7.0.1",
    "@capacitor/core": "^7.0.1",
    "@capacitor/filesystem": "^7.0.1",
    "@capacitor/haptics": "^7.0.1",
    "@capacitor/keyboard": "^7.0.1",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^6.0.1",
    "@capacitor/share": "^7.0.1",
    "@capacitor/splash-screen": "^7.0.0",
    "@capacitor/status-bar": "^7.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.504.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.3.0",
    "tailwind-merge": "^3.0.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.1",
    "@testing-library/react": "^16.3.0",
    "@types/jszip": "^3.4.1",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.5.0",
    "autoprefixer": "^10.4.17",
    "happy-dom": "^15.11.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "~5.8.2",
    "vite": "^7.0.0",
    "vitest": "^3.1.0"
  }
}

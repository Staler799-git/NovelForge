{
  "name": "novelforge",
  "private": true,
  "version": "1.1.1",
  "description": "NovelForge – Web Novel to EPUB Converter for iOS (React + TypeScript + Capacitor)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/check-css.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:visual": "vitest run src/tests/visual-smoke.test.tsx",
    "check:css": "node scripts/check-css.mjs",
    "preview:ui": "node scripts/render-ui-preview.mjs",
    "ios:sync": "npx cap sync ios && node scripts/patch-ios-plugins.mjs",
    "ios:copy": "npx cap copy ios && node scripts/patch-ios-plugins.mjs",
    "ios:open": "npx cap open ios",
    "ios:add": "npx cap add ios",
    "ios:build:unsigned": "bash scripts/build-ios-unsigned.sh",
    "validate:codemagic": "node scripts/validate-codemagic.mjs"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/app": "^8.1.2",
    "@capacitor/camera": "^8.2.6",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.504.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.3.0",
    "tailwind-merge": "^3.0.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@testing-library/react": "^16.3.0",
    "@types/jszip": "^3.4.1",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.5.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "autoprefixer": "^10.4.17",
    "happy-dom": "^15.11.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "~5.8.2",
    "vite": "^7.0.0",
    "vitest": "^3.1.0",
    "yaml": "^2.8.1"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
